# Copy this file to `.streamlit/secrets.toml` for LOCAL runs, or paste the same
# line into the "Secrets" box when deploying on Streamlit Community Cloud.
# NEVER commit the real secrets.toml — it is git-ignored.
GEMINI_API_KEY = "your_api_key_here"

# Optional overrides:
# GEMINI_MODEL = "gemini-2.5-flash"
# GEMINI_RESEARCH_MODEL = "gemini-2.5-flash"
