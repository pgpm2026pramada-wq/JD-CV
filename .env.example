# Google Gemini API key — get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here

# Optional overrides
PORT=3000
# Model used for structured analysis (JD/CV fit, gaps, optimizer, interview prep)
GEMINI_MODEL=gemini-2.5-flash
# Model used for company/industry research with Google Search grounding
GEMINI_RESEARCH_MODEL=gemini-2.5-flash
